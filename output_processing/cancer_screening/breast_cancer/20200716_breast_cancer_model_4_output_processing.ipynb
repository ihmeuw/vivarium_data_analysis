   "source": [
    "delta_count = (count.set_index(cols)\n",
    "               .sub(count[count.scenario == 'baseline'].drop(columns='scenario').set_index([c for c in cols if c != 'scenario']))\n",
    "               .reset_index())\n",
    "\n",
    "delta_rate = (delta_count.set_index(cols)\n",
    "              .div(df['person_time'].drop(columns='measure').set_index([c for c in cols if c != 'measure']))\n",
    "              .mul(100_000)\n",
    "              .reset_index())\n",
    "\n",
    "delta_rate_summary = (delta_rate\n",
    "                      .groupby([c for c in cols if c != 'input_draw'])\n",
    "                      .value.describe(percentiles=[.025, .975])\n",
    "                      .filter(['mean', '2.5%', '97.5%'])\n",
    "                      .reset_index())\n",
    "delta_rate_summary"
   ]
