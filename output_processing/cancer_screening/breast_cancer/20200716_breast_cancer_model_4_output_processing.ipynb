    "with PdfPages(master_dir + 'c429_incidence_from_sim_baseline_vs_forecast_by_age.pdf') as pdf:\n",
    "    for sex in ['female', 'male']:\n",
    "        for year in range(2020, 2040):\n",
    "            sim_vs_forecast_by_age(bc_incidence_sim, bc_incidence_forecast, sex, year, 'Incidence')\n",
    "            pdf.savefig(bbox_inches='tight')"
   ]
