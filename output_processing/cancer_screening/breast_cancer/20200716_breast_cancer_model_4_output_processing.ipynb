   "source": [
    "def plot_over_year(data: pd.DataFrame, measure: str, age_cohort: str, sex='female', delta=False):\n",
    "    data_sub = data[(data.age_cohort == age_cohort) \n",
    "                    & (data.sex == sex)\n",
    "                    & (data.measure == measure)]\n",
    "    \n",
    "    plt.figure(figsize=(8, 6), dpi=150)\n",
    "    \n",
    "    if delta:\n",
    "        data_scenario = data_sub[data_sub.scenario == 'alternative']\n",
    "        plt.plot(data_scenario['year'], data_scenario['mean'] , marker='o')\n",
    "        plt.fill_between(data_scenario['year'], data_scenario['2.5%'], data_scenario['97.5%'], alpha=.3)\n",
    "    else:\n",
    "        for scenario in ['baseline', 'alternative']:\n",
    "            data_scenario = data_sub[data_sub.scenario == scenario]\n",
    "            plt.plot(data_scenario['year'], data_scenario['mean'] , marker='o', label=scenario)\n",
    "            plt.fill_between(data_scenario['year'], data_scenario['2.5%'], data_scenario['97.5%'], alpha=.3)\n",
    "            plt.legend(loc=(1.05, .1))\n",
    " \n",
    "    if  measure == 'benign_breast_cancer_detection_count':\n",
    "        outcome = 'stage 0 breast cancer detection'\n",
    "    else: # measure == 'breast_cancer_detection_count':\n",
    "        outcome = 'stage 1+ breast cancer detection'\n",
    "\n",
    "    birth_cohort_start, birth_cohort_end = age_cohort.split('_to_')\n",
    "    \n",
    "    plt.xlabel('Year')\n",
    "    plt.ylabel('Cases per 100,000 person-years')\n",
    "    if delta:\n",
    "        plt.title(f'delta {outcome} in women born from {birth_cohort_start} to {birth_cohort_end}')\n",
    "    else:\n",
    "        plt.title(f'{outcome} in women born from {birth_cohort_start} to {birth_cohort_end}')\n",
    "    plt.margins(.1)"
   ]
  },
