   "source": [
    "state_person_time = df['state_person_time'].loc[\n",
    "    df['state_person_time'].cause.isin(['breast_cancer', 'ductal_carcinoma_in_situ', 'lobular_carcinoma_in_situ'])\n",
    "]\n",
    "\n",
    "prevalence = (state_person_time.drop(columns='measure').set_index([c for c in cols if c != 'measure'] + ['cause'])\n",
    "              .div(df['person_time'].drop(columns='measure').set_index([c for c in cols if c != 'measure']))\n",
    "              .mul(100)\n",
    "              .reset_index())\n",
    "\n",
    "prevalence_summary = (prevalence\n",
    "                      .groupby([c for c in cols if c not in ['input_draw', 'measure']] + ['cause'])\n",
    "                      .value.describe(percentiles=[.025, .975])\n",
    "                      .filter(['mean', '2.5%', '97.5%'])\n",
    "                      .reset_index())\n",
    "prevalence_summary"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Compare breast cancer prevalence from sim baseline to forecast data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "# breast cancer prevalence in sim baseline\n",
    "bc_prevalence_sim = prevalence_summary.query('scenario == \"baseline\" and cause == \"breast_cancer\"')\n",
    "bc_prevalence_sim['age_midpoint'] = list(map(lambda x, y: y-int(x.split('_to_')[1])+2, bc_prevalence_sim['age_cohort'], bc_prevalence_sim['year']))\n",
    "\n",
    "# breast cancer prevalence forecast\n",
    "bc_prevalence_forecast = (pd\n",
    "                         .read_csv(master_dir + 'forecasts/c429_prev_forecast.csv')\n",
    "                         .drop(columns=['location', 'age_group_id', 'sex_id'])\n",
    "                         .rename(columns={'year_id': 'year'}))\n",
    "bc_prevalence_forecast['age_midpoint'] = bc_prevalence_forecast['age'].map(lambda x: int(x.split(' ')[0])+2)\n",
    "bc_prevalence_forecast[['mean', 'lb', 'ub']] *= 100"
   ]
  },
