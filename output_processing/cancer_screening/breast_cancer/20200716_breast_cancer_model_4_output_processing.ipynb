   "metadata": {},
   "source": [
    "# Incidence and Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "def breast_cancer_event_count(df: pd.DataFrame, measure_dcis: str, measure_lcis: str, outcome: str):\n",
    "    \"\"\"\n",
    "    breast_cancer_incidence_count = \n",
    "    ductal_carcinoma_in_situ_to_breast_cancer_event_count + \n",
    "    lobular_carcinoma_in_situ_to_breast_cancer_event_count\n",
    "    \n",
    "    breast_cancer_detectiob_count = \n",
    "    positive_screening_ductal_carcinoma_in_situ_to_positive_screening_breast_cancer_event_count +\n",
    "    positive_screening_lobular_carcinoma_in_situ_to_positive_screening_breast_cancer_event_count +\n",
    "    negative_screening_to_positive_screening_breast_cancer_event_count\n",
    "    \n",
    "    benign_breast_cancer_detection_count =\n",
    "    negative_screening_to_positive_screening_ductal_carcinoma_in_situ_event_count +\n",
    "    negative_screening_to_positive_screening_lobular_carcinoma_in_situ_event_count\n",
    "    \"\"\"\n",
    "    count_from_dcis = (df\n",
    "                       .query(f'measure == \"{measure_dcis}\"')\n",
    "                       .drop(columns='measure')\n",
    "                       .set_index([c for c in cols if c != 'measure']))\n",
    "\n",
    "    count_from_lcis = (df\n",
    "                       .query(f'measure == \"{measure_lcis}\"')\n",
    "                       .drop(columns='measure')\n",
    "                       .set_index([c for c in cols if c != 'measure']))\n",
    "    \n",
    "    detection_count_from_bc = (df\n",
    "                               .query('measure == \"negative_screening_to_positive_screening_breast_cancer_event_count\"')\n",
    "                               .drop(columns='measure')\n",
    "                               .set_index([c for c in cols if c != 'measure']))\n",
    "    \n",
    "    if outcome == 'breast_cancer_detection_count':\n",
    "        total = (count_from_dcis + count_from_lcis + detection_count_from_bc).reset_index()\n",
    "    else: # outcome == benign_breast_cancer_detection_count | breast_cancer_incidence_count\n",
    "        total = (count_from_dcis + count_from_lcis).reset_index()\n",
    "    total['measure'] = outcome\n",
    "    return total"
   ]
