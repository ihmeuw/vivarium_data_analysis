   "source": [
    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "pd.set_option('display.max_rows', 8)\n",
    "\n",
    "import glob\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "from matplotlib.backends.backend_pdf import PdfPages\n",
    "!whoami"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "master_dir = 'C:/Users/yongqx2/Desktop/Sim Science/Swiss RE Cancer/'\n",
    "# /ihme/costeffectiveness/results/vivarium_csu_swissre_cancer/v4.1_family_history/swissre_coverage/2020_07_15_18_34_50/count_data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "cols = ['age_cohort', 'sex', 'year', 'input_draw', 'scenario', 'measure']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "fnames = ['deaths', 'person_time', 'state_person_time', 'transition_count']\n",
    "df = {}\n",
    "for fname in fnames:\n",
    "    df[fname] = pd.read_csv(master_dir + 'count_data_model_4/' + fname + '.csv').iloc[:, 1:]\n",
    "    df[fname]['risk'] = df[fname]['age_cohort'].map(lambda x: 'family_history_' + x.split('_family_history_')[1])\n",
    "    df[fname]['age_cohort'] = df[fname]['age_cohort'].map(lambda x: x.split('_family_history_')[0])\n",
    "    if fname in ['deaths', 'state_person_time']:\n",
    "        df[fname] = df[fname].groupby(cols + ['cause']).value.sum().reset_index()\n",
    "    else:\n",
    "        df[fname] = df[fname].groupby(cols).value.sum().reset_index()"
   ]
  },
