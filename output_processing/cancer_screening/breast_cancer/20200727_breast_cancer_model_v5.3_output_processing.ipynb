      "person_time ['sex', 'year', 'input_draw', 'scenario', 'value', 'age_cohort', 'measure', 'family_history', 'screening']\n",
      "state_person_time ['sex', 'year', 'cause', 'input_draw', 'scenario', 'value', 'age_cohort', 'measure', 'family_history']\n",
      "transition_count ['sex', 'year', 'input_draw', 'scenario', 'value', 'age_cohort', 'measure', 'family_history']\n"
     ]
    }
