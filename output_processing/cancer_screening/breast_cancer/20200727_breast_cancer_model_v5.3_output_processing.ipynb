  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Compare deaths due to breast cancer from sim baseline to forecast data¶"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# cause-specific mortaliyt of breast cancer in sim baseline\n",
    "bc_csmr_sim = csmr_summary.query('scenario == \"baseline\" and cause == \"breast_cancer\"')\n",
    "bc_csmr_sim['age_midpoint'] = list(map(lambda x, y: y-int(x.split('_to_')[1])+2, bc_csmr_sim['age_cohort'], bc_csmr_sim['year']))\n",
    "\n",
    "# cause-specific mortality of breast cancer forecast\n",
    "bc_csmr_forecast = (pd\n",
    "                    .read_csv(master_dir + 'forecasts/c429_csmr_forecast.csv')\n",
    "                    .drop(columns=['location', 'age_group_id', 'sex_id'])\n",
    "                    .rename(columns={'year_id': 'year'}))\n",
    "bc_csmr_forecast['age_midpoint'] = bc_csmr_forecast['age'].map(lambda x: int(x.split(' ')[0])+2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "def sim_vs_forecast_by_age(sim: pd.DataFrame, forecast: pd.DataFrame, sex: str, year: int, measure: str):\n",
    "    sim_sub = sim[(sim.year == year) & (sim.sex == sex)]\n",
    "    forecast_sub = forecast[(forecast.year == year) & (forecast.sex == sex)]\n",
    "    \n",
    "    plt.figure(figsize=(6, 4), dpi=120)\n",
    "    plt.plot(sim_sub['age_midpoint'], sim_sub['mean'], marker='o', label='sim baseline')\n",
    "    plt.fill_between(sim_sub['age_midpoint'], sim_sub['2.5%'], sim_sub['97.5%'], alpha=.3)\n",
    "    plt.plot(forecast_sub['age_midpoint'], forecast_sub['mean'], marker='o', label='forecast')\n",
    "    plt.fill_between(forecast_sub['age_midpoint'], forecast_sub['lb'], forecast_sub['ub'], alpha=.3)\n",
    "    plt.title(f'{sex}, {year}')\n",
    "    plt.xlabel('Age')\n",
    "    if measure == 'Deaths':\n",
    "        plt.ylabel('Deaths due to breast cancer\\n (per 100,000 PY)')\n",
    "    elif measure == 'Incidence':\n",
    "        plt.ylabel('Incidence of breast cancer\\n (Cases per 100,000 PY)')\n",
