    "from matplotlib.backends.backend_pdf import PdfPages\n",
    "!whoami"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "master_dir = 'C:/Users/yongqx2/Desktop/Sim Science/Swiss RE Cancer/'\n",
    "# /ihme/costeffectiveness/results/vivarium_csu_swissre_cancer/v5.3_remission/swissre_coverage/2020_07_24_12_35_43/count_data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "fnames = ['deaths', 'person_time', 'state_person_time', 'transition_count']\n",
    "df = {}\n",
    "for fname in fnames:\n",
    "    df[fname] = pd.read_csv(master_dir + 'breast_cancer_output/count_data_model_5/' + fname + '.csv').iloc[:, 1:]\n",
    "    if fname in ['deaths', 'person_time']:\n",
    "        df[fname]['family_history'] = (df[fname]['age_cohort']\n",
    "                                       .map(lambda x: x.split('_family_history_')[1].split('_screening_result_')[0]))\n",
    "        df[fname]['screening'] = (df[fname]['age_cohort']\n",
    "                                  .map(lambda x: x.split('_family_history_')[1].split('_screening_result_')[1]))\n",
    "        df[fname]['age_cohort'] = df[fname]['age_cohort'].map(lambda x: x.split('_family_history_')[0])\n",
    "    else:\n",
    "        df[fname]['family_history'] = df[fname]['age_cohort'].map(lambda x: x.split('_family_history_')[1])\n",
    "        df[fname]['age_cohort'] = df[fname]['age_cohort'].map(lambda x: x.split('_family_history_')[0])"
   ]
  },
