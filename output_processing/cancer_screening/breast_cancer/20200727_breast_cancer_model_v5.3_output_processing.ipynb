  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "cols = ['age_cohort', 'sex', 'year', 'input_draw', 'scenario', 'measure']"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Deaths"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "# csmr\n",
    "def calc_csmr(deaths: pd.DataFrame, person_time: pd.DataFrame, agg_col=[]):\n",
    "    deaths_agg = deaths.groupby(cols + ['cause'] + agg_col).value.sum().reset_index()\n",
    "    person_time_agg = person_time.groupby(cols + agg_col).value.sum().reset_index()\n",
    "    \n",
    "    csmr = (deaths_agg.drop(columns='measure').set_index([c for c in cols if c != 'measure'] + ['cause'] + agg_col)\n",
    "            .div(person_time_agg.drop(columns='measure').set_index([c for c in cols if c != 'measure'] + agg_col))\n",
    "            .mul(100_000)\n",
    "            .reset_index())\n",
    "    csmr_summary = (csmr\n",
    "                    .groupby(['age_cohort', 'sex', 'year', 'scenario', 'cause'] + agg_col)\n",
    "                    .value.describe(percentiles=[.025, .975])\n",
    "                    .filter(['mean', '2.5%', '97.5%'])\n",
    "                    .reset_index())\n",
    "    \n",
    "    return csmr_summary"
   ]
  },
